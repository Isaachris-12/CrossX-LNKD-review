# Postgres connection used by Prisma
DATABASE_URL="postgresql://crossx:crossx@localhost:5432/crossx"

# Redis connection used by BullMQ
REDIS_URL="redis://localhost:6379"

# JWT signing secret for access/refresh tokens (generate a real random value before deploying)
JWT_SECRET="dev-only-change-me"

# AES-256-GCM key for encrypting stored OAuth tokens at rest (must be 32 bytes; generate a real one before deploying)
TOKEN_ENCRYPTION_KEY="dev-only-change-me-32-bytes-min!"

PORT=4000

# The app's custom URL scheme (must match apps/mobile/app.json "scheme")
APP_SCHEME="crossxlnkd"

# This server's own public HTTPS origin, used to build each platform's OAuth
# redirect_uri. Platforms reject non-HTTPS redirects, so local dev needs a
# tunnel, e.g.: ngrok http 4000  ->  PUBLIC_BASE_URL="https://<id>.ngrok-free.app"
PUBLIC_BASE_URL=""

# Meta app credentials (Facebook Login - covers both Facebook and Instagram).
# Create an app at https://developers.facebook.com, add "Facebook Login for
# Business", and register both:
#   ${PUBLIC_BASE_URL}/oauth/facebook/callback
#   ${PUBLIC_BASE_URL}/oauth/instagram/callback
# as valid OAuth redirect URIs.
META_APP_ID=""
META_APP_SECRET=""
META_GRAPH_VERSION="v21.0"

# TikTok app credentials (Login Kit + Content Posting API, requires approval).
# Create an app at https://developers.tiktok.com and register:
#   ${PUBLIC_BASE_URL}/oauth/tiktok/callback
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# LinkedIn app credentials (Sign In with LinkedIn using OpenID Connect + Share
# on LinkedIn, requires the w_member_social product). Create an app at
# https://www.linkedin.com/developers/apps and register:
#   ${PUBLIC_BASE_URL}/oauth/linkedin/callback
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# YouTube app credentials (Google OAuth + YouTube Data API v3). Create OAuth
# 2.0 credentials at https://console.cloud.google.com (enable "YouTube Data
# API v3") and register:
#   ${PUBLIC_BASE_URL}/oauth/youtube/callback
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""

# Reddit app credentials. Create an app at https://www.reddit.com/prefs/apps
# (type: "web app") and register:
#   ${PUBLIC_BASE_URL}/oauth/reddit/callback
# Reddit requires a descriptive User-Agent on every API call - format is
# "platform:app_id:version (by /u/username)".
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USER_AGENT="web:crossxlnkd:v1.0 (by /u/your-reddit-username)"

# Pinterest app credentials (API v5). Create an app at
# https://developers.pinterest.com/apps and register:
#   ${PUBLIC_BASE_URL}/oauth/pinterest/callback
# New apps start in "Trial" (sandbox-only) access - apply for "Standard"
# access before this can post to real boards.
PINTEREST_CLIENT_ID=""
PINTEREST_CLIENT_SECRET=""

# Mastodon and Bluesky need no app credentials here - Mastodon registers an
# OAuth app per-instance automatically at connect time, and Bluesky
# authenticates with a user-supplied handle + app password.

# Media storage. Leave all four blank to use the local-disk storage driver
# (server/media-storage/, works out of the box for dev). Set all four to
# switch to S3-compatible storage (AWS S3, Cloudflare R2, MinIO, Backblaze
# B2, ...) for production.
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Only needed for a non-AWS S3-compatible provider (R2/MinIO/etc).
S3_ENDPOINT=""
# Optional: a CDN domain in front of the bucket, instead of the bucket's
# default S3 URL.
S3_PUBLIC_URL_BASE=""

# RevenueCat webhook: set this to the same value configured as the
# "Authorization" header in the RevenueCat dashboard's Webhooks settings
# (Project Settings -> Integrations -> Webhooks), pointed at
# ${PUBLIC_BASE_URL}/webhooks/revenuecat. Generate a real random value -
# this is how we verify a webhook request actually came from RevenueCat.
REVENUECAT_WEBHOOK_SECRET=""
